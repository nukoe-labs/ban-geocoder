{
  "name": "ban-geocoder",
  "version": "0.1.0",
  "description": "Small typed client for French address search and reverse geocoding with the BAN API (Addok format).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "changelog": "git-cliff --output CHANGELOG.md",
    "version": "git-cliff --tag v$npm_package_version --output CHANGELOG.md && git add CHANGELOG.md"
  },
  "keywords": [
    "geocoding",
    "reverse-geocoding",
    "ban",
    "addok",
    "france",
    "address",
    "geojson"
  ],
  "author": "Mickael Saidi (https://nukoe.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nukoe-labs/ban-geocoder.git"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.15.0",
    "git-cliff": "^2.14.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.4"
  }
}
